# ==============================================
# Financial Research Assistant - Environment Variables
# ==============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# --- Database ---
DATABASE_URL=postgresql+psycopg2://postgres:yourpassword@localhost:5432/financial_research
# When using Docker Compose, use:
# DATABASE_URL=postgresql+psycopg2://postgres:yourpassword@db:5432/financial_research

# --- Security ---
# Generate a secure secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- LLM Provider Selection ---
# Options: gemini (Recommended) | openai | claude | ollama
LLM_PROVIDER=gemini

# --- 1. Google Gemini / Google AI Studio (First & Recommended Option) ---
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# --- 2. OpenAI (Secondary Option) ---
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# --- 3. Anthropic Claude (Third Option - optional) ---
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# --- 4. Ollama (Local LLM - optional) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Embedding Model ---
# Downloads automatically on first startup (~130MB)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- RAG Configuration ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_CHUNKS_RETRIEVED=20
TOP_K_AFTER_RERANK=5
DENSE_WEIGHT=0.7
BM25_WEIGHT=0.3
MAX_HISTORY_MESSAGES=10

# --- File Upload ---
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=uploads
